# LINE Messaging API
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Admin API Key (generate a random string)
API_KEY=your_api_key_here

# Workers API URL (set after deploying worker)
NEXT_PUBLIC_API_URL=https://your-worker.your-subdomain.workers.dev

# Web app / LINE content sync
APP_BASE_URL=https://your-admin.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
CRON_SECRET=your_random_cron_secret_here
INTERNAL_NOTIFY_SECRET=your_random_internal_notify_secret_here
